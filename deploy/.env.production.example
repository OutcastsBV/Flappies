# VPS production template — copy to .env on the server.
# Public URL: http://10.61.2.101 (change PUBLIC_HOST if you get a domain later)
#
# Images are pulled from private GHCR (no build on the server):
#   ghcr.io/outcastsbv/flappies-api
#   ghcr.io/outcastsbv/flappies-frontend
#
# This stack is APP-ONLY (Postgres + API + frontend). It connects to shared
# company infrastructure for identity (a central ZITADEL) and, optionally,
# observability (Prometheus/Loki) and email (SMTP) — it does not self-host
# any of those. See docs/DEPLOYMENT.md for the support boundary.

PUBLIC_HOST=10.61.2.101

# --- App Postgres ---
POSTGRES_DB=flappies
POSTGRES_USER=flappies
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Public URLs (must match the frontend image built by GitHub Actions) ---
CORS_ORIGIN=http://10.61.2.101:3002
FRONTEND_URL=http://10.61.2.101:3002
API_PORT=3001
FRONTEND_PORT=3002

COOKIE_SECURE=false
TRUST_PROXY=true

# --- Central ZITADEL (shared company infrastructure — not started by this
# compose file). Provision this tenant with
# ./deploy/scripts/provision-tenant-zitadel.sh (or the manual steps in
# docs/KUBERNETES.md), then fill in the values below. ---
ZITADEL_URL=https://auth.company.example.com
ZITADEL_CLIENT_ID=flappies
ZITADEL_CLIENT_SECRET=change-me-client-secret
ZITADEL_REDIRECT_URI=http://10.61.2.101:3002/callback
ZITADEL_AUDIENCE=flappies
# Project that owns the admin/manager/cashier roles (Console -> Projects -> your project -> Project ID)
ZITADEL_PROJECT_ID=change-me-project-id
ZITADEL_IMPERSONATOR_PAT=change-me-impersonator-pat
# Client credentials of the same service machine user (Users → machine user → Keys)
ZITADEL_IMPERSONATOR_CLIENT_ID=change-me-service-user-client-id
ZITADEL_IMPERSONATOR_CLIENT_SECRET=change-me-service-user-client-secret
# Optional org id header for user creation
ZITADEL_ORG_ID=

# 32-byte key used to encrypt payment method API keys (Stripe/SumUp) at rest.
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=change-me-32-byte-encryption-key
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Observability — all optional. Point these at YOUR OWN Prometheus Pushgateway
# / Loki instance (the company's master one, or anything else). Flappies only
# supports the connection between this app and those services, not the
# services themselves.
# -----------------------------------------------------------------------------
TENANT_ID=change-me-tenant-slug
# PROMETHEUS_PUSHGATEWAY_URL=https://pushgateway.company.example.com
# PROMETHEUS_PUSH_INTERVAL_MS=15000
# METRICS_TOKEN=change-me-metrics-token
# LOKI_URL=https://loki.company.example.com
# LOKI_USERNAME=
# LOKI_PASSWORD=

# -----------------------------------------------------------------------------
# Support / feature-request form (admin panel button) — optional, any
# SMTP-capable provider works. Leave SMTP_HOST unset to disable the form.
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=change-me@flappies.shop
# SMTP_PASSWORD=change-me-smtp-password
# SMTP_FROM=change-me@flappies.shop
# SUPPORT_EMAIL_TO=support@flappies.shop

# Optional: pin a specific image tag instead of latest (git SHA from Actions)
# FLAPPIES_IMAGE_TAG=latest
