# VPS production template — copy to .env on the server.
# Public URL: http://10.61.2.101 (change PUBLIC_HOST if you get a domain later)
#
# Images are pulled from private GHCR (no build on the server):
#   ghcr.io/outcastsbv/flappies-api
#   ghcr.io/outcastsbv/flappies-frontend

PUBLIC_HOST=10.61.2.101

# --- App Postgres ---
POSTGRES_DB=flappies
POSTGRES_USER=flappies
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Public URLs (must match the frontend image built by GitHub Actions) ---
CORS_ORIGIN=http://10.61.2.101:3002
FRONTEND_URL=http://10.61.2.101:3002
API_PORT=3001
FRONTEND_PORT=3002

ZITADEL_URL=http://10.61.2.101:8080
ZITADEL_REDIRECT_URI=http://10.61.2.101:3002/callback
ZITADEL_EXTERNALDOMAIN=10.61.2.101
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false

COOKIE_SECURE=false
TRUST_PROXY=true

# --- ZITADEL secrets (first-instance admin for ZITADEL console only — not app login yet) ---
# MASTERKEY must be EXACTLY 32 characters (bytes). Generate: tr -dc A-Za-z0-9 </dev/urandom | head -c 32
ZITADEL_MASTERKEY=change-me-32-char-zitadel-mkey!!
ZITADEL_DB_PASSWORD=change-me-zitadel-db-password
ZITADEL_ADMIN_USER=admin
# YOU choose this password (upper + lower + digit). Used to create the ZITADEL console admin on first boot.
ZITADEL_ADMIN_PASSWORD=ChangeMe-Admin-Password1!
ZITADEL_ADMIN_EMAIL=admin@localhost
ZITADEL_ORG_NAME=Flappies

# ZITADEL console login = ZITADEL_ADMIN_USER + ZITADEL_ADMIN_PASSWORD above (only after successful first init).
# Flappies app login = same ZITADEL password + ./deploy/scripts/bootstrap-app-admin.sh <user-uuid>

# From ZITADEL console after first boot (OAuth app + service user PAT)
ZITADEL_CLIENT_ID=flappies
ZITADEL_CLIENT_SECRET=change-me-client-secret
ZITADEL_AUDIENCE=flappies
ZITADEL_IMPERSONATOR_PAT=change-me-impersonator-pat
# Client credentials of the same service machine user (Users → machine user → Keys)
ZITADEL_IMPERSONATOR_CLIENT_ID=change-me-service-user-client-id
ZITADEL_IMPERSONATOR_CLIENT_SECRET=change-me-service-user-client-secret

RFID_WS_SECRET=change-me-rfid-ws-secret
OPERATION_MODE=self_service
LOG_LEVEL=info

# Optional: pin a specific image tag instead of latest (git SHA from Actions)
# FLAPPIES_IMAGE_TAG=latest
