# Copy to `.env.local` for local development.
#
#   cp .env.example .env.local

NEXT_PUBLIC_ZITADEL_URL=http://localhost:8080
NEXT_PUBLIC_ZITADEL_CLIENT_ID=kassasysteem
NEXT_PUBLIC_ZITADEL_REDIRECT_URI=http://localhost:3002/callback
NEXT_PUBLIC_ZITADEL_LOGOUT_URI=http://localhost:3002/
NEXT_PUBLIC_API_URL=http://localhost:3001
# Auto-logout after this many seconds without mouse/keyboard/touch activity (default 300 = 5 min)
NEXT_PUBLIC_SESSION_IDLE_SECONDS=300
