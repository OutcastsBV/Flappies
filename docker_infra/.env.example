# Copy this file to `.env` and adjust values once for your environment.
# Keep `.env` private (gitignored). Store a backup in your team password manager.
#
#   cp .env.example .env
#
# Changing ZITADEL domain or master key after first boot requires wiping the
# ZITADEL Postgres volume — see README.md.

# -----------------------------------------------------------------------------
# KassaSysteem app (API + frontend + database)
# -----------------------------------------------------------------------------
APP_POSTGRES_DB=kassasysteem
APP_POSTGRES_USER=kassa
APP_POSTGRES_PASSWORD=change-me-app-db-password
APP_API_PORT=3001
APP_FRONTEND_PORT=3002
CORS_ORIGIN=http://localhost:3002

ZITADEL_URL=http://localhost:8080
ZITADEL_INTERNAL_URL=http://zitadel:8080
ZITADEL_CLIENT_ID=kassasysteem
ZITADEL_CLIENT_SECRET=change-me-from-zitadel-console
ZITADEL_REDIRECT_URI=http://localhost:3002/callback
ZITADEL_IMPERSONATOR_PAT=
TOP_UP_EPC_QR_ENABLED=false
TOP_UP_STRIPE_ENABLED=false
EPC_QR_IBAN=
EPC_QR_BENEFICIARY_NAME=
EPC_QR_BIC=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3002
OPERATION_MODE=self_service

NEXT_PUBLIC_ZITADEL_URL=http://localhost:8080
NEXT_PUBLIC_ZITADEL_CLIENT_ID=kassasysteem
NEXT_PUBLIC_ZITADEL_REDIRECT_URI=http://localhost:3002/callback
NEXT_PUBLIC_ZITADEL_LOGOUT_URI=http://localhost:3002/
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# ZITADEL
# -----------------------------------------------------------------------------
ZITADEL_POSTGRES_DB=zitadel
ZITADEL_POSTGRES_USER=zitadel
ZITADEL_POSTGRES_PASSWORD=change-me-zitadel-db-password

# Exactly 32 characters. Generate: tr -dc A-Za-z0-9 </dev/urandom | head -c 32
ZITADEL_MASTERKEY=change-me-32-char-zitadel-mkey!!

# Must match the hostname users type in the browser (no scheme, no port).
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false

ZITADEL_HOST_PORT=8080

ZITADEL_FIRSTINSTANCE_ORG_NAME=Nerdlab
ZITADEL_FIRSTINSTANCE_ORG_DOMAIN=localhost
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=ChangeMe-Admin-Password1!
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS=admin@example.com

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# -----------------------------------------------------------------------------
# Vault (dev mode only — not for production)
# -----------------------------------------------------------------------------
VAULT_DEV_ROOT_TOKEN_ID=change-me-vault-dev-token

# -----------------------------------------------------------------------------
# Unleash (feature flags)
# -----------------------------------------------------------------------------
UNLEASH_POSTGRES_DB=unleash
UNLEASH_POSTGRES_USER=unleash
UNLEASH_POSTGRES_PASSWORD=change-me-unleash-db-password
UNLEASH_DEFAULT_ADMIN_USERNAME=admin
UNLEASH_DEFAULT_ADMIN_PASSWORD=change-me-unleash-admin-password

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
