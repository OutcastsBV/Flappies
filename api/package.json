{
  "name": "api",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "migrate": "node scripts/migrate.js",
    "dev": "node server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/**/*.e2e.test.js",
    "test:http": "node scripts/run-tests.js",
    "test:db:setup": "node -e \"require('./tests/helpers/migrate').setupDatabase().then(() => process.exit(0)).catch((err) => { console.error(err); process.exit(1); })\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Flappies API",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "jose": "^6.1.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.17.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-loki": "^3.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2"
  }
}
