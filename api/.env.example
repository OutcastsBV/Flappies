# Copy to `.env` and fill in values from your ZITADEL console.
#
#   cp .env.example .env

PGHOST=localhost
PGPORT=5432
PGUSER=flappies
PGPASSWORD=change-me-db-password
PGDATABASE=flappies

ZITADEL_URL=http://localhost:8080
ZITADEL_INTERNAL_URL=http://zitadel:8080
ZITADEL_CLIENT_ID=flappies
ZITADEL_CLIENT_SECRET=change-me-from-zitadel-console
ZITADEL_REDIRECT_URI=http://localhost:3002/callback
ZITADEL_AUDIENCE=flappies
# PAT for token exchange (RFID) and Session API login. Service user needs:
#   - IAM_LOGIN_CLIENT (instance → Default settings) for password login
#   - ORG_USER_IMPERSONATOR (org) for token exchange after login
ZITADEL_IMPERSONATOR_PAT=change-me-optional-for-rfid-login
# Optional override for Session API / user management (defaults to impersonator PAT)
# ZITADEL_SERVICE_PAT=
# Optional org id for user creation header
# ZITADEL_ORG_ID=

CORS_ORIGIN=http://localhost:3002
RFID_WS_SECRET=change-me-rfid-ws-secret
FRONTEND_URL=http://localhost:3002
OPERATION_MODE=self_service

# Top-up (EPC QR + Stripe)
TOP_UP_EPC_QR_ENABLED=false
TOP_UP_STRIPE_ENABLED=false
EPC_QR_IBAN=
EPC_QR_BENEFICIARY_NAME=
EPC_QR_BIC=
STRIPE_SECRET_KEY=change-me-from-stripe-dashboard
STRIPE_WEBHOOK_SECRET=change-me-from-stripe-webhook
