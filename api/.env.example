# Copy to `.env` and fill in values from your ZITADEL console.
#
#   cp .env.example .env

PGHOST=localhost
PGPORT=5432
PGUSER=flappies
PGPASSWORD=change-me-db-password
PGDATABASE=flappies

ZITADEL_URL=http://localhost:8080
ZITADEL_INTERNAL_URL=http://zitadel:8080
ZITADEL_CLIENT_ID=flappies
ZITADEL_CLIENT_SECRET=change-me-from-zitadel-console
ZITADEL_REDIRECT_URI=http://localhost:3002/callback
ZITADEL_AUDIENCE=flappies
# Project that owns the admin/manager/cashier roles (Console -> Projects -> your project -> copy the Project ID)
ZITADEL_PROJECT_ID=change-me-from-zitadel-console
# PAT for the impersonation token exchange used after password login. Service user needs:
#   - IAM_LOGIN_CLIENT (instance -> Default settings) for password login
#   - ORG_USER_IMPERSONATOR (org) for token exchange after login
#   - user.grant.write permission to assign/change roles from the Users admin panel
ZITADEL_IMPERSONATOR_PAT=change-me-impersonator-pat
# Optional override for Session API / user management (defaults to impersonator PAT)
# ZITADEL_SERVICE_PAT=
# Optional org id for user creation header
# ZITADEL_ORG_ID=

CORS_ORIGIN=http://localhost:3002
FRONTEND_URL=http://localhost:3002

# 32-byte key used to encrypt payment method API keys (Stripe/SumUp) at rest.
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=change-me-32-byte-encryption-key

# -----------------------------------------------------------------------------
# Observability — all optional. Leave unset to disable that integration; the
# app runs fine without any of them (see docs/KUBERNETES.md for the tradeoffs).
# -----------------------------------------------------------------------------

# Identifies this deployment in the shared/master Prometheus + Loki instances.
# Set this to something unique per tenant, e.g. the tenant slug.
TENANT_ID=default

# Prometheus: push-based metrics to a central Pushgateway (pull-based scraping
# of a per-tenant /metrics endpoint usually isn't reachable from outside the
# tenant's network, so push is the default model here).
# PROMETHEUS_PUSHGATEWAY_URL=https://pushgateway.example.com
# PROMETHEUS_PUSH_INTERVAL_MS=15000
# Optional bearer token required to read the local GET /metrics endpoint.
# METRICS_TOKEN=change-me-metrics-token

# Loki: ship structured logs directly from the API (no local log-shipping
# agent needed). LOKI_USERNAME/PASSWORD are only needed for Grafana Cloud
# Loki or a Loki instance with basic auth in front of it.
# LOKI_URL=https://loki.example.com
# LOKI_USERNAME=
# LOKI_PASSWORD=

# SMTP: used by the admin "Support / feature request" form. Any SMTP-capable
# provider works (Microsoft 365, Gmail, Postmark, etc.) — swapping providers
# later is just an env var change, no code change.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=change-me@flappies.shop
# SMTP_PASSWORD=change-me-smtp-password
# SMTP_FROM=change-me@flappies.shop
# SUPPORT_EMAIL_TO=support@flappies.shop

# Timeout for outbound calls to ZITADEL's Management/Session/OAuth APIs so an
# unreachable ZITADEL fails fast instead of hanging admin requests.
# ZITADEL_HTTP_TIMEOUT_MS=10000
